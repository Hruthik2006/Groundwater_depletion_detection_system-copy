# ==============================================================================
# Satellite-Enhanced Groundwater Level Prediction System Environment Template
# Copy this file to .env and insert your real credentials:
# cp .env.example .env
# ==============================================================================

# 1. Google Earth Engine (GEE) Authentication
GEE_PROJECT_ID=your_gee_project_id_here

# 2. NASA EarthData Authentication (GRACE, GLDAS, MODIS Ingestion)
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password
EARTHDATA_BEARER_TOKEN=your_earthdata_token_here

# 3. USGS NWIS Piezometer API
USGS_API_KEY=your_usgs_api_key_here

# 4. Mapbox GL / GIS High-Res Satellite Tiles
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# 5. Application Server Configuration
ENV=development
PORT=8000
SECRET_KEY=change_this_secret_in_production

# 6. ThingSpeak IoT Field Sensors (borewell rig — live hardware feed)
THINGSPEAK_CHANNEL_ID=3575415
THINGSPEAK_READ_KEY=<redacted>

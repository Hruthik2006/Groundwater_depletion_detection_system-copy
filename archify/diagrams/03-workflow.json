  "cards": [
    {
      "dot": "cyan",
      "title": "Single entry point",
      "items": [
        "SystemState builds the pipeline once and serves every /api/v1 route on demand",
        "Report HTML is streamed with live solver tables, never canned placeholders"
      ]
    },
    {
      "dot": "emerald",
      "title": "Honest channel recovery",
      "items": [
        "Provider seam declares capabilities + is_synthetic per channel",
        "A missing DWLR hydromet channel falls back to the calibrated synthetic replica"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety before serving",
      "items": [
        "MPC enforces h_min + q_hat and shrinks δ on infeasibility before returning",
